import numpy as np
import matplotlib.pyplot as plt
from collections import Counter
import re

# Завдання 1. Графік функції
x = np.linspace(0, 4, 500)
y = 5 * np.sin(10 * x) * np.sin(3 * x)

plt.plot(x, y, color="blue")
plt.title("Y(x) = 5 sin(10x) sin(3x)")
plt.xlabel("x")
plt.ylabel("Y(x)")
plt.grid()
plt.savefig("graph.png")
plt.show()

# Текст для завдань 2 і 3
text = """
Python є популярною мовою програмування.
Чи легко вивчати Python? Так, це цікаво!
Програмування відкриває нові можливості...
Matplotlib допомагає будувати графіки.
"""

# Завдання 2. Частота появи літер
letters = Counter(c.lower() for c in text if c.isalpha())

plt.bar(letters.keys(), letters.values(), color="green")
plt.title("Частота появи літер")
plt.xlabel("Літери")
plt.ylabel("Кількість")
plt.grid(axis="y")
plt.savefig("letters.png")
plt.show()

# Завдання 3. Типи речень
sentences = re.split(r'(?<=[.!?…])\s+', text.strip())

types = {
    "Звичайні": 0,
    "Питальні": 0,
    "Окличні": 0,
    "Трикрапка": 0
}

for sentence in sentences:
    sentence = sentence.strip()
    if not sentence:
        continue
    if sentence.endswith("...") or sentence.endswith("…"):
        types["Трикрапка"] += 1
    elif sentence.endswith("?"):
        types["Питальні"] += 1
    elif sentence.endswith("!"):
        types["Окличні"] += 1
    else:
        types["Звичайні"] += 1

plt.bar(types.keys(), types.values(), color="orange")
plt.title("Кількість різних типів речень")
plt.xlabel("Тип речення")
plt.ylabel("Кількість")
plt.grid(axis="y")
plt.savefig("sentences.png")
plt.show()
